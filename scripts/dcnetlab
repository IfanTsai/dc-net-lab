#!/usr/bin/env bash
# DCNetLab launcher: one command to start/stop the controller and web UI.
#
#   scripts/dcnetlab up          build backend + web UI, start controller serving both
#   scripts/dcnetlab up --dev    start controller + Vite dev server (hot reload)
#   scripts/dcnetlab down        stop everything started by "up"
#   scripts/dcnetlab status      show what is running
#   scripts/dcnetlab logs        tail controller logs
#
# Configuration via environment:
#   DCNETLAB_LISTEN   controller address (default 127.0.0.1:8080)
#   DCNETLAB_RUNTIME  runtime driver: auto|containerlab|noop (default auto)

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUN_DIR="$ROOT/.run"
LISTEN="${DCNETLAB_LISTEN:-127.0.0.1:8080}"
RUNTIME="${DCNETLAB_RUNTIME:-auto}"
CTRL_PID="$RUN_DIR/controller.pid"
WEB_PID="$RUN_DIR/web.pid"
CTRL_LOG="$RUN_DIR/controller.log"
WEB_LOG="$RUN_DIR/web.log"

alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

stop_pid() { # stop_pid <pidfile> <name> [group]
  if alive "$1"; then
    local pid target; pid="$(cat "$1")"
    # With "group", the pid is a setsid group leader: kill the whole
    # group so children (npm -> sh -> vite) do not survive as orphans.
    target="$pid"; [ "${3:-}" = "group" ] && target="-$pid"
    kill -- "$target" 2>/dev/null || true
    for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    kill -9 -- "$target" 2>/dev/null || true
    echo "stopped $2 (pid $pid)"
  fi
  rm -f "$1"
}

wait_healthy() {
  for _ in $(seq 1 50); do
    if curl -sf "http://$LISTEN/api/v1/healthz" >/dev/null 2>&1; then return 0; fi
    sleep 0.2
  done
  echo "controller did not become healthy; see $CTRL_LOG" >&2
  return 1
}

cmd_up() {
  local dev=0
  [ "${1:-}" = "--dev" ] && dev=1

  if alive "$CTRL_PID"; then
    echo "already running (pid $(cat "$CTRL_PID")); use 'down' first" >&2
    exit 1
  fi
  mkdir -p "$RUN_DIR"

  echo "building controller..."
  (cd "$ROOT" && go build -o bin/dcnetlab-controller ./cmd/controller)

  local web_args=()
  if [ "$dev" = 0 ]; then
    if [ ! -d "$ROOT/web/node_modules" ]; then
      echo "installing web dependencies..."
      (cd "$ROOT/web" && npm install --silent)
    fi
    echo "building web UI..."
    (cd "$ROOT/web" && npm run build --silent >"$WEB_LOG" 2>&1)
    web_args=(--web-dir "$ROOT/web/dist")
  fi

  echo "starting controller on $LISTEN (runtime: $RUNTIME)..."
  nohup "$ROOT/bin/dcnetlab-controller" \
    --listen "$LISTEN" \
    --data-dir "$ROOT/data" \
    --runtime "$RUNTIME" \
    "${web_args[@]}" >"$CTRL_LOG" 2>&1 </dev/null &
  echo $! >"$CTRL_PID"
  wait_healthy

  if [ "$dev" = 1 ]; then
    echo "starting Vite dev server..."
    # setsid may fork, so the session leader writes its own pid;
    # "down" kills that process group to take npm and vite with it.
    (cd "$ROOT/web" && WEB_PID="$WEB_PID" setsid bash -c 'echo $$ >"$WEB_PID"; exec npm run dev' >"$WEB_LOG" 2>&1 </dev/null &)
    for _ in $(seq 1 20); do [ -s "$WEB_PID" ] && break; sleep 0.1; done
    echo
    echo "DCNetLab is up:  http://localhost:5173  (dev, hot reload)"
    echo "API:             http://$LISTEN"
  else
    echo
    echo "DCNetLab is up:  http://$LISTEN"
  fi
}

cmd_down() {
  stop_pid "$WEB_PID" "web dev server" group
  stop_pid "$CTRL_PID" "controller"
  echo "DCNetLab is down"
}

cmd_status() {
  if alive "$CTRL_PID"; then
    echo "controller: running (pid $(cat "$CTRL_PID"), http://$LISTEN)"
  else
    echo "controller: stopped"
  fi
  if alive "$WEB_PID"; then
    echo "web dev:    running (pid $(cat "$WEB_PID"), http://localhost:5173)"
  else
    echo "web dev:    stopped"
  fi
}

cmd_logs() { tail -n 100 -f "$CTRL_LOG"; }

case "${1:-}" in
  up) shift; cmd_up "$@" ;;
  down) cmd_down ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
